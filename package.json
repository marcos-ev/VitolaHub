{
  "name": "vitola-hub",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=packages/shared",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:shop-panel": "npm run dev --workspace=apps/shop-panel",
    "dev:website": "npm run dev --workspace=apps/website",
    "build:website": "npm run build --workspace=apps/website",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:demo": "tsx prisma/seed-demo.ts",
    "build": "npm run build --workspace=apps/api",
    "build:prod": "npm run build:shared && npm run prisma:generate && npm run build --workspace=apps/api",
    "start:prod": "node apps/api/dist/main.js",
    "build:shop-panel": "npm run build --workspace=apps/shop-panel",
    "test:api": "npm run test --workspace=apps/api"
  },
  "dependencies": {
    "prisma": "^5.20.0"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
