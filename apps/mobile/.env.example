# URL base da API (obrigatório quando EXPO_PUBLIC_DEMO_MODE=false)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Modo demonstração — intercepta chamadas API com dados mock offline.
# • EAS profile "preview" (APK): EXPO_PUBLIC_DEMO_MODE=true (automático via eas.json)
# • Build local preview: copie env.preview.example → .env.production.local (ver npm run build:apk:local)
# • Desenvolvimento com API real: mantenha false ou omita esta variável
EXPO_PUBLIC_DEMO_MODE=false
