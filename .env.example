# ---------------------------------------------------------------------------
# Banco de dados
# connection_limit dimensionado para ~5 mil usuários ativos: um monólito Nest
# rodando com poucas réplicas não precisa de mais que isso, e evita esgotar
# max_connections do Postgres sob pico de tráfego.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://charuto:charuto@localhost:5432/charuto?connection_limit=20&pool_timeout=10"

# ---------------------------------------------------------------------------
# Redis (cache + BullMQ)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_MAX_RETRIES_PER_REQUEST=null

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="troque-este-segredo-de-acesso"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh"
JWT_REFRESH_TTL="30d"

APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Storage de mídia (S3-compatível; MinIO em dev, Cloudflare R2 em produção)
# ---------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="charuto-media"
S3_ACCESS_KEY_ID="charuto"
S3_SECRET_ACCESS_KEY="charuto123"
S3_PUBLIC_BASE_URL="http://localhost:9000/charuto-media"
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_YEARLY=""
STRIPE_PRICE_SHOP_MONTHLY=""

# ---------------------------------------------------------------------------
# Reconhecimento por foto (Fase 4)
# ---------------------------------------------------------------------------
RECOGNITION_PROVIDER="anthropic" # anthropic | google
ANTHROPIC_API_KEY=""
GOOGLE_GENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Push / e-mail
# ---------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Vitola Hub <no-reply@vitolahub.com.br>"
# Destino dos formulários do site (contato / fundador). Padrão: vitolahub@gmail.com
CONTACT_TO_EMAIL="vitolahub@gmail.com"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
WEB_APP_URL="http://localhost:8081"
